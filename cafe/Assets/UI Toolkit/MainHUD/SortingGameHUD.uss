/* Portrait Mobile Adjustments (1080x1920 focus) */

.full-screen {
    width: 100%;
    height: 100%;
    background-color: transparent;
}

.mobile-top {
    height: 300px;
    padding: 80px 60px 0 60px; /* 좌우 여백 추가 */
    flex-direction: row;
    justify-content: space-between; /* 좌우 끝으로 벌리기 */
    align-items: center;
}

.top-group {
    margin: 0;
}

.badge-level-large {
    width: 140px;
    height: 140px;
    border-radius: 70px;
    background-color: #63d4b5; /* Minty Green */
    border-width: 4px;
    border-color: #ffffff;
    align-items: center;
    justify-content: center;
    /* Soft shadow */
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
    margin-top: -10px; /* Slight lift */
}

.badge-level-large Label {
    font-size: 60px;
    color: white;
    -unity-font-style: bold;
}

/* Premium Button Theme (Glassmorphism inspired) */
.btn-menu {
    width: 140px; /* 레벨 배지와 동일한 크기 */
    height: 140px;
    border-radius: 70px; /* 원형으로 통일 */
    background-color: rgba(255, 255, 255, 0.4); 
    border-width: 4px; /* 테두리 두께 통일 */
    border-color: #ffffff;
    justify-content: center;
    align-items: center;
    transition-duration: 0.2s;
    /* 레벨 배지와 동일한 그림자 효과 */
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
}

.btn-menu:active {
    scale: 0.9;
    background-color: rgba(255, 255, 255, 0.6);
}

.lbl-btn-bottom {
    font-size: 26px;
    color: #4a4a4a;
    -unity-font-style: bold;
    margin-top: 90px;
}

/* Glassmorphism Panel */
.glass-panel {
    background-color: rgba(255, 255, 255, 0.8);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.8);
    border-color: rgba(255, 255, 255, 1);
    border-width: 4px;
    border-radius: 60px;
    /* Soft glow */
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
}

.glass-label {
    background-color: rgba(255, 255, 255, 0.7);
    color: #333333;
    border-radius: 40px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.9);
    padding: 30px 60px;
}

.popup-title {
    font-size: 64px;
    color: #4ebfa5;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

/* Popup & Overlay Container */
.popup-container {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);
    pointer-events: auto; /* 기본적으로는 클릭 차단 (팝업 시) */
}

/* 튜토리얼은 클릭을 통과시켜야 함 */
#tutorial-overlay {
    background-color: rgba(0, 0, 0, 0); /* 배경 투명하게 (pointer-events를 위해) */
    pointer-events: none;
    justify-content: flex-end; /* 아래로 배치 */
    padding-bottom: 250px;    /* 하단 여백 */
}

.popup-panel {
    width: 850px;
    padding: 100px 60px;
    align-items: center;
}

.popup-title {
    font-size: 84px; /* 크기 확대 */
    color: #4ebfa5;
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.popup-msg {
    font-size: 40px;
    color: #666;
    margin-bottom: 40px;
}

.btn-primary {
    width: 550px;
    height: 140px;
    background-color: #ff9f89; 
    color: white;
    font-size: 52px; /* 크기 확대 */
    -unity-font-style: bold;
    border-radius: 70px;
    border-width: 0;
    margin-top: 20px;
    box-shadow: 0 12px 0 #e88d77;
}

.btn-primary:active {
    translate: 0 12px;
    box-shadow: 0 4px 0 #e88d77;
}

/* Tutorial Style Upgrade */
.glass-label {
    background-color: rgba(255, 255, 255, 0.9);
    color: #222;
    border-radius: 50px;
    border-width: 3px;
    border-color: white;
    padding: 50px 80px;
    font-size: 42px; /* 크기 확대 */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    box-shadow: 0 15px 30px rgba(0,0,0,0.2);
}

.icon-restart { 
    background-image: url('project://database/Assets/4.Sprite/restart_icon.png');
    -unity-background-scale-mode: scale-to-fit;
    width: 90px; /* 버튼 크기에 맞춰 아이콘 크기 약간 확대 */
    height: 90px;
    -unity-background-image-tint-color: white; 
}
