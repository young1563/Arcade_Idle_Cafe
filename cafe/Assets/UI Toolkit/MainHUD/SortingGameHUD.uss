/* Portrait Mobile Adjustments (1080x1920 focus) */

.full-screen {
    width: 100%;
    height: 100%;
    background-color: transparent;
}

.mobile-top {
    height: 300px;
    padding: 80px 60px 0 60px; /* 좌우 여백 추가 */
    flex-direction: row;
    justify-content: space-between; /* 좌우 끝으로 벌리기 */
    align-items: center;
}

.top-group {
    margin: 0;
}

.badge-level-large {
    width: 240px; /* 크기 확대 및 통일 */
    height: 240px;
    background-image: url('project://database/Assets/4.Sprite/StackGame/1.png');
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0;
    /* Soft shadow */
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
    margin-top: -30px; /* 약간 더 위로 조정 */
}

.badge-level-large Label {
    font-size: 100px; /* 더 크게 키워 시원하게 표시 */
    color: white;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0,0,0,0.3);
    padding-top: 25px;
}

/* Premium Button Theme (Glassmorphism inspired) */
.btn-menu {
    width: 240px; /* 레벨 배지와 동일한 크기 */
    height: 240px;
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
    transition-duration: 0.2s;
    background-image: url('project://database/Assets/4.Sprite/StackGame/2.png');
    -unity-background-scale-mode: scale-to-fit;
    margin-top: -30px;
}

.btn-menu:active {
    scale: 0.9;
    background-color: rgba(255, 255, 255, 0.6);
}

.lbl-btn-bottom {
    font-size: 26px;
    color: #4a4a4a;
    -unity-font-style: bold;
    margin-top: 90px;
}

/* Glassmorphism Panel */
.glass-panel {
    background-color: rgba(255, 255, 255, 0.8);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.8);
    border-color: rgba(255, 255, 255, 1);
    border-width: 4px;
    border-radius: 60px;
    /* Soft glow */
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
}

.glass-label {
    background-color: rgba(255, 255, 255, 0.7);
    color: #333333;
    border-radius: 40px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.9);
    padding: 30px 60px;
}

.popup-title {
    font-size: 64px;
    color: #4ebfa5;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

/* Popup & Overlay Container */
.popup-container {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);
    pointer-events: auto; /* 기본적으로는 클릭 차단 (팝업 시) */
}

/* 튜토리얼은 클릭을 통과시켜야 함 */
#tutorial-overlay {
    background-color: rgba(0, 0, 0, 0); /* 배경 투명하게 (pointer-events를 위해) */
    pointer-events: none;
    justify-content: flex-end; /* 아래로 배치 */
    padding-bottom: 250px;    /* 하단 여백 */
}

.popup-panel {
    width: 850px;
    padding: 100px 60px;
    align-items: center;
}

.popup-title {
    font-size: 84px; /* 크기 확대 */
    color: #4ebfa5;
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.popup-msg {
    font-size: 40px;
    color: #666;
    margin-bottom: 40px;
}

.btn-primary {
    width: 550px;
    height: 140px;
    background-color: #ff9f89; 
    color: white;
    font-size: 52px; /* 크기 확대 */
    -unity-font-style: bold;
    border-radius: 70px;
    border-width: 0;
    margin-top: 20px;
    box-shadow: 0 12px 0 #e88d77;
}

.btn-primary:active {
    translate: 0 12px;
    box-shadow: 0 4px 0 #e88d77;
}

/* Tutorial Style Upgrade */
#lbl-tutorial {
    color: #5d4037;
    font-size: 52px; /* 가독성을 위해 폰트 크기 확대 */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    /* 텍스트를 위로 올려 이미지 안쪽으로 배치 */
    margin-top: -80px; 
}

.tutorial-bg {
    background-image: url('project://database/Assets/4.Sprite/StackGame/3.png');
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-repeat: no-repeat;
    width: 1000px;
    height: 400px; /* 높이를 충분히 주어 잘림 방지 */
    justify-content: center;
    align-items: center;
    background-color: transparent;
    border-width: 0;
}

.icon-restart { 
    /* 이미지 중복 적용 방지 (btn-menu에서 처리) */
    width: 140px; 
    height: 140px;
}
