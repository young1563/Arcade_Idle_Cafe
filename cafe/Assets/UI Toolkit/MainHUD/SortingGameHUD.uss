/* Sorting Game Specific Styles */

.popup-container {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
}

.popup-panel {
    width: 300px;
    padding: 30px;
    background-color: #ffffff;
    border-radius: 30px;
    border-width: 5px;
    border-color: #f1c40f;
    align-items: center;
}

.popup-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: #2d3436;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.popup-content {
    align-items: center;
    margin-bottom: 30px;
}

.popup-msg {
    font-size: 18px;
    color: #636e72;
}

.reward-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.reward-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: #2ecc71;
}

.btn-primary {
    width: 200px;
    height: 60px;
    background-color: #6c5ce7;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    border-radius: 30px;
    border-width: 0;
    transition: scale 0.1s;
}

.btn-primary:hover {
    scale: 1.1;
}

.icon-restart {
    background-image: url("project:/Assets/4.Sprite/nav.png"); /* Placeholder */
    -unity-background-image-tint-color: #e67e22;
}

.icon-undo { -unity-background-image-tint-color: #bdc3c7; }
.icon-hint { -unity-background-image-tint-color: #f1c40f; }
