/* Lobby Styling */
.lobby-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

.dim-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.45);
}

.lobby-content {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding-bottom: 200px;
}

.lobby-header {
    margin-bottom: 120px;
    align-items: center;
}

.lobby-title {
    color: white;
    -unity-font-style: bold;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgba(0,0,0,0.4);
    text-shadow: 0 10px 10px rgba(0,0,0,0.3);
}

.main-title {
    font-size: 140px;
    margin-bottom: -40px;
}

.sub-title {
    font-size: 100px;
    color: #ffccbc;
}

.main-play-section {
    margin-bottom: 80px;
}

.btn-play-large {
    width: 500px;
    height: 500px;
    background-image: url('project://database/Assets/4.Sprite/StackGame/2.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.btn-play-large:active {
    scale: 0.9;
}

.lbl-play-next {
    font-size: 52px;
    color: #5d4037;
    -unity-font-style: bold;
    margin-top: 150px;
}

.btn-secondary {
    width: 400px;
    height: 120px;
    border-radius: 60px;
    background-color: rgba(255, 255, 255, 0.25);
    border-width: 4px;
    border-color: white;
    color: white;
    font-size: 44px;
    -unity-font-style: bold;
    text-shadow: 0 4px 4px rgba(0,0,0,0.3);
}

.btn-secondary:active {
    background-color: rgba(255, 255, 255, 0.5);
    scale: 0.95;
}

/* Stage Select Popup Extension */
.stage-panel {
    width: 950px;
    height: 1200px;
    padding: 80px 40px;
}

.level-grid-scroll {
    flex-grow: 1;
    margin: 40px 0;
}

.level-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 20px;
}

/* Individual Stage Button Styles */
.btn-level {
    width: 180px;
    height: 180px;
    margin: 20px;
    background-color: #ffd8a8;
    border-radius: 40px;
    border-width: 0;
    justify-content: center;
    align-items: center;
    box-shadow: 0 10px 0 #e67700;
}

.btn-level:active {
    translate: 0 10px;
    box-shadow: 0 0 0 #e67700;
}

.btn-level.unlocked {
    background-color: #ff922b;
    color: white;
}

.btn-level.locked {
    background-color: #dee2e6;
    color: #adb5bd;
    box-shadow: 0 10px 0 #adb5bd;
}

.btn-level.cleared {
    background-color: #40c057;
    box-shadow: 0 10px 0 #2b8a3e;
}

.lbl-level-num {
    font-size: 64px;
    -unity-font-style: bold;
}
