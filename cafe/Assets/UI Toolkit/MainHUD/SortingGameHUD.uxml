<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" picking-mode="Ignore" class="full-screen">
        <Style src="project://database/Assets/UI%20Toolkit/MainHUD/MainHUD.uss?fileID=7433441132597879392&amp;guid=afae5dc157c393044ae0aa601395e10d&amp;type=3#MainHUD" />
        <Style src="project://database/Assets/UI%20Toolkit/MainHUD/SortingGameHUD.uss?fileID=7433441132597879392&amp;guid=0f55b79d96ee41649b54c0844425fbb9&amp;type=3#SortingGameHUD" />
        <ui:VisualElement name="top-hud" class="hud-container-row">
            <ui:VisualElement name="top-left-group" class="group-row">
                <ui:Button name="btn-restart" tooltip="Restart Level" class="btn-circle icon-restart" />
            </ui:VisualElement>
            <ui:VisualElement name="top-center-group" class="level-container">
                <ui:VisualElement name="level-badge" class="badge-level">
                    <ui:Label text="1" name="lbl-level" />
                </ui:VisualElement>
                <ui:VisualElement name="progress-bar-bg" class="progress-bg">
                    <ui:VisualElement name="progress-bar-fill" class="progress-fill" style="width: 0%;" />
                    <ui:Label text="SORTING..." name="lbl-progress" class="lbl-progress" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="top-right-group" class="group-column align-end">
                <ui:VisualElement class="resource-panel money">
                    <ui:VisualElement class="icon-resource icon-money" />
                    <ui:Label text="0" name="lbl-money" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="middle-hud" class="grow-1 row" style="pointer-events: none;" />
        <ui:VisualElement name="bottom-hud" class="hud-container-column">
            <ui:VisualElement class="row" style="margin-bottom: 20px;">
                <ui:Button name="btn-hint" class="btn-menu icon-hint">
                    <ui:Label text="HINT" class="lbl-btn-bottom" />
                </ui:Button>
                <ui:Button name="btn-undo" class="btn-menu icon-undo">
                    <ui:Label text="UNDO" class="lbl-btn-bottom" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="win-popup" class="popup-container" style="display: none;">
            <ui:VisualElement class="popup-panel">
                <ui:Label text="SWEET CLEAR!" class="popup-title" />
                <ui:VisualElement class="popup-content">
                    <ui:Label text="Level Complete" class="popup-msg" />
                    <ui:VisualElement class="reward-row">
                        <ui:VisualElement class="icon-resource icon-money" />
                        <ui:Label text="+100" class="reward-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="btn-next" text="NEXT LEVEL" class="btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
